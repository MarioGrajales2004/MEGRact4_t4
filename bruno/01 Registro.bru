meta {
  name: 01 Registro
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "nombre": "Mario Eduardo Grajales Ramirez",
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

tests {
  test("201 Created (409 si el usuario ya estaba registrado)", function() {
    expect(res.status).to.be.oneOf([201, 409]);
  });
  test("La respuesta no incluye el password", function() {
    expect(res.body.password).to.be.undefined;
  });
}
