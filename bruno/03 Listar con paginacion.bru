meta {
  name: 03 Listar con paginacion
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/libros?page=0&size=5
  body: none
  auth: bearer
}

params:query {
  page: 0
  size: 5
}

auth:bearer {
  token: {{token}}
}

tests {
  test("200 OK con una pagina de maximo 5 libros", function() {
    expect(res.status).to.equal(200);
    expect(res.body.contenido.length).to.be.at.most(5);
    expect(res.body.pagina).to.equal(0);
  });
}
