meta {
  name: 06 Actualizar
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/api/libros/{{libroId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "titulo": "El llano en llamas (edicion conmemorativa)",
    "autor": "Juan Rulfo",
    "anio": 1953,
    "precio": 219.0,
    "editorialId": 2
  }
}

tests {
  test("200 OK con los datos actualizados", function() {
    expect(res.status).to.equal(200);
    expect(res.body.precio).to.equal(219);
  });
}
